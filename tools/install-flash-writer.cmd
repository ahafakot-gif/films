Add-Type -AssemblyName System.Windows.Forms
try {
    Write-Host ''
    Write-Host '  Установка программы «Запись флешек»...' -ForegroundColor Yellow
    $dir = Join-Path $env:LOCALAPPDATA 'FlashWriter'
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    $dst = Join-Path $dir 'flash-writer.ps1'
    $b64 = ($PAYLOAD -join '')
    [IO.File]::WriteAllBytes($dst, [Convert]::FromBase64String($b64))
    Write-Host "  1) Программа записана: $dst"

    $psExe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    $icon  = (Join-Path $env:SystemRoot 'System32\shell32.dll') + ',7'
    $menu  = 'Записать на флешки (работа)'
    $cmd   = '"' + $psExe + '" -NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File "' + $dst + '"'
    $targets = @(
        @{ Key = 'Software\Classes\Drive\shell\FlashWriter';                Arg = '-Kind drive -Path "%1"' },
        @{ Key = 'Software\Classes\Directory\shell\FlashWriter';            Arg = '-Kind folder -Path "%1"' },
        @{ Key = 'Software\Classes\Directory\Background\shell\FlashWriter'; Arg = '-Kind folder -Path "%V"' },
        @{ Key = 'Software\Classes\*\shell\FlashWriter';                    Arg = '-Kind file -Path "%1"' }
    )
    foreach ($t in $targets) {
        $k = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey($t.Key)
        $k.SetValue('MUIVerb', $menu); $k.SetValue('Icon', $icon); $k.Close()
        $c = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey($t.Key + '\command')
        $c.SetValue('', $cmd + ' ' + $t.Arg); $c.Close()
    }
    Write-Host "  2) Пункт в меню правой кнопки: «$menu»"

    $sh = New-Object -ComObject WScript.Shell
    foreach ($p in @([Environment]::GetFolderPath('Desktop'), [Environment]::GetFolderPath('Programs'))) {
        if (-not $p -or -not (Test-Path -LiteralPath $p)) { continue }
        $lnkPath = Join-Path $p 'Запись флешек.lnk'
        $tmpLnk  = Join-Path $p 'FlashWriter-tmp.lnk'
        try {
            $s = $sh.CreateShortcut($tmpLnk)
            $s.TargetPath = $psExe
            $s.Arguments = '-NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File "' + $dst + '"'
            $s.WorkingDirectory = $dir
            $s.IconLocation = $icon
            $s.Save()
            Move-Item -LiteralPath $tmpLnk -Destination $lnkPath -Force
        } catch {
            Write-Host ('  Ярлык не получился в ' + $p + ': ' + $_.Exception.Message) -ForegroundColor Red
            continue
        }
        Write-Host "  3) Ярлык: $lnkPath"
    }
    Write-Host ''
    Write-Host '  ГОТОВО! Ярлык «Запись флешек» на рабочем столе.' -ForegroundColor Green
    [System.Windows.Forms.MessageBox]::Show("Установлено!`r`n`r`nЯрлык «Запись флешек» — на рабочем столе и в меню «Пуск».`r`nИли правая кнопка на флешку / папку → «$menu»`r`n(в Windows 11 сначала «Показать дополнительные параметры»).", 'Запись флешек') | Out-Null
}
catch {
    Write-Host ''
    Write-Host ('  ОШИБКА: ' + $_.Exception.Message) -ForegroundColor Red
    Write-Host '  Сфотографируйте это окно и пришлите.' -ForegroundColor Red
}
